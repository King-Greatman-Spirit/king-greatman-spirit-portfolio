# ============================================================
# KING GREATMAN SPIRIT — PRODUCTION ENVIRONMENT (HOSTINGER)
# Copy this file to your host as ".env" and fill in every value.
# ============================================================

# Django secret key (generate a fresh one — NEVER reuse your local dev key)
SECRET_KEY="etrkqwvlzklum33e640^r5rvf*u3c^*(pn4*4sxd(4=kua@6#e"

# Production: DEBUG must be false (never true on the live site)
DEBUG=false

# Your live domain + localhost for checks
ALLOWED_HOSTS=kinggreatmanspirit.com,www.kinggreatmanspirit.com,127.0.0.1,localhost

# CSRF origins (must match the exact HTTPS URLs you use)
CSRF_TRUSTED_ORIGINS=https://kinggreatmanspirit.com,https://www.kinggreatmanspirit.com

# Canonical site URL used in emails, sitemaps and notifications
SITE_URL=https://kinggreatmanspirit.com

# Google Search Console site verification token (paste from GSC)
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=

# ------------------------------------------------------------
# DATABASE (sqlite is used by default — the db.sqlite3 file must
# be uploaded to the host together with the code)
# ------------------------------------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ------------------------------------------------------------
# EMAIL — choose ONE option:
# A) Hostinger email (recommended, you have free mailboxes):
#    HOST=smtp.hostinger.com  PORT=465  TLS=false  SSL=true
#    USER=hello@kinggreatmanspirit.com
#    PASSWORD=<your mailbox password>
# B) Gmail (needs a 16-char App Password from myaccount.google.com):
#    HOST=smtp.gmail.com  PORT=587  TLS=true  SSL=false
# ------------------------------------------------------------
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=hello@kinggreatmanspirit.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=King Greatman Spirit <hello@kinggreatmanspirit.com>

# ------------------------------------------------------------
# PAYMENT GATEWAYS — dashboard.flutterwave.com / dashboard.paystack.com
# / merchant.binance.com. Leave keys empty to run in "manual
# verification" mode (payments still work, you confirm manually).
# ------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

BINANCE_API_KEY=
BINANCE_PRIVATE_KEY=

# ------------------------------------------------------------
# LIVE SUPPORT ALERTS (support tickets -> WhatsApp + SMS)
# Free credentials at https://www.twilio.com. Leave empty to
# fall back to email notifications.
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
SUPPORT_NOTIFY_WHATSAPP_TO=whatsapp:+2349014155705
SUPPORT_NOTIFY_PHONE=+2349014155705
SUPPORT_NOTIFY_EMAIL=spiritpydev@gmail.com

TIME_ZONE=UTC
