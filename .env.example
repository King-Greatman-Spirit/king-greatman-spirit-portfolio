# ============================================================
# KING GREATMAN SPIRIT — ENVIRONMENT TEMPLATE
# Copy this file to `.env` on the server and fill in the values:
#   cp .env.example .env
# NEVER commit the real .env (it holds live secrets).
# Local dev works with sqlite automatically; only set DB_* +
# DB_ENGINE when deploying with Docker/PostgreSQL.
# ============================================================

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=kinggreatmanspirit.com,www.kinggreatmanspirit.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://kinggreatmanspirit.com,https://www.kinggreatmanspirit.com,http://127.0.0.1,http://localhost

DJANGO_SUPERUSER_EMAIL=admin@kinggreatmanspirit.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_FIRST_NAME=kinggreatman
DJANGO_SUPERUSER_LAST_NAME=spirit
DJANGO_SUPERUSER_PASSWORD=change-me

# Database — leave DB_ENGINE empty for SQLite (local dev).
# With Docker/PostgreSQL: DB_ENGINE=django.db.backends.postgresql
DB_ENGINE=
DB_NAME=kgs_db
DB_USER=kgs_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

TIME_ZONE=UTC
SITE_URL=https://kinggreatmanspirit.com

# Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============ PAYMENT GATEWAYS ============
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Binance Pay — OFF until merchant account is fully approved.
# Re-enable: BINANCE_ENABLED=True + merchant ID from the MMP portal
BINANCE_API_KEY=
BINANCE_PRIVATE_KEY=
BINANCE_MERCHANT_ID=
BINANCE_ENABLED=False
BINANCE_NGN_USDT_RATE=

# ============ EMAIL (Gmail SMTP) ============
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=true

# ============ LIVE SUPPORT ALERTS (Twilio) ============
# Leave SID/TOKEN empty to use the email fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
SUPPORT_NOTIFY_WHATSAPP_TO=whatsapp:+2349014155705
SUPPORT_NOTIFY_PHONE=+2349014155705
SUPPORT_NOTIFY_EMAIL=kinggreatmanspirit@gmail.com